# Copy this file to .env.local and fill in your values.
# Variables marked * are required — the app will throw on startup if missing.

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin                          # * login username for /admin
ADMIN_PASSWORD_HASH=                          # * SHA-256 hex of your password
                                              #   generate: echo -n "yourpass" | sha256sum

# ── Institution ───────────────────────────────────────────────────────────────
INSTITUTION_NAME=Harbour.Space University     #   name shown in Gemini system prompts
                                              #   defaults to "this university" if unset

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                               # * Google AI Studio API key

# ── Upstash Redis REST (@upstash/redis — sessions, leads, sources) ────────────
KV_REST_API_URL=                              # * https://<name>.upstash.io
KV_REST_API_TOKEN=                            # * REST token (read/write)

# ── Upstash Redis TCP (ioredis — pub/sub only) ────────────────────────────────
REDIS_URL=                                    # * rediss://default:<token>@<host>:6379
                                              #   same instance as above, TCP connection

# ── Upstash Vector (RAG / semantic search) ────────────────────────────────────
UPSTASH_VECTOR_REST_URL=                      # * https://<name>.upstash.io
UPSTASH_VECTOR_REST_TOKEN=                    # * Vector REST token (read/write)
